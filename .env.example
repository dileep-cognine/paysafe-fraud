# Environment Configuration
APP_ENV=dev
CONFIG_PATH=configs/dev.yaml

# MLflow Tracking & Registry
MLFLOW_TRACKING_URI=sqlite:///mlruns.db
MLFLOW_EXPERIMENT_NAME=fraud-scoring-dev
MODEL_REGISTRY_NAME=paysafe-fraud-detector
MODEL_ALIAS=champion

# API Service
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
LOG_LEVEL=INFO

# Optional local, free Ollama-assisted merchant category mapping.
LLM_CATEGORY_MAPPING_ENABLED=false
LLM_CATEGORY_MAPPING_MODEL=llama3.2:3b
LLM_CATEGORY_MAPPING_BASE_URL=http://127.0.0.1:11434
LLM_CATEGORY_MAPPING_TIMEOUT_SECONDS=5
