# Environment Configuration
APP_ENV=dev
# CONFIG_PATH=configs/dev.yaml

# MLflow Tracking & Registry
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=fraud-scoring-dev
MODEL_REGISTRY_NAME=paysafe-fraud-detector
MODEL_ALIAS=champion

# API Service
API_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=1
LOG_LEVEL=info

LLM_CATEGORY_MAPPING_ENABLED=false
LLM_CATEGORY_MAPPING_MODEL=your-ollama-model-name
LLM_CATEGORY_MAPPING_BASE_URL=your-ollama-base-url
LLM_CATEGORY_MAPPING_TIMEOUT_SECONDS=5


COMPOSE_MLFLOW_TRACKING_URI=http://mlflow:5000
COMPOSE_MLFLOW_PORT=5000
COMPOSE_API_PORT=8000
COMPOSE_MLFLOW_EXPERIMENT_NAME=paysafe-fraud-scoring-prod
COMPOSE_MODEL_REGISTRY_NAME=paysafe-fraud-detector
COMPOSE_MODEL_ALIAS=champion
COMPOSE_LOG_LEVEL=info
